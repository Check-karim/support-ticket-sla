generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REPORTER
  AGENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  reportedTickets Ticket[]  @relation("TicketReporter")
  assignedTickets Ticket[]  @relation("TicketAssignee")
  comments        Comment[]

  @@index([role])
}

model Ticket {
  id              String       @id @default(cuid())
  title           String
  description     String       @db.Text
  priority        Priority
  status          TicketStatus @default(OPEN)
  reporterId      String
  reporter        User         @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assigneeId      String?
  assignee        User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  comments        Comment[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([createdAt])
  @@index([status, priority])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
  @@index([ticketId, createdAt])
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}
